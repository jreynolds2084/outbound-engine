# Database
DATABASE_URL=mysql://user:pass@localhost:3306/outbound

# LLM (OpenRouter by default; LLM_API_URL only if you change provider)
OPENROUTER_API_KEY=
LLM_API_URL=

# Signing secret for unsubscribe tokens
JWT_SECRET=

# Sending
RESEND_API_KEY=
TRANSACTIONAL_FROM="Your Product <noreply@example.com>"
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/oauth/google/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_OAUTH_REDIRECT_URI=http://localhost:3000/api/oauth/microsoft/callback

# Public URLs
PUBLIC_BASE_URL=https://app.example.com
PUBLIC_SITE_URL=https://example.com

# Sender identity and signature
BRAND_NAME="Outbound Beast"
SENDER_NAME="Your Name"
SENDER_ADDRESS=you@example.com
SENDER_TITLE="Account Executive"
SENDER_PHONE=
BOOKING_URL=https://example.com/book
SUPPORT_EMAIL=support@example.com

# Owner notifications
OWNER_NOTIFICATION_EMAIL=owner@example.com
OWNER_NOTIFICATION_FROM=noreply@example.com
